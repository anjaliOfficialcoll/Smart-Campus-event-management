# ---------- Application Name ----------
spring.application.name=SmartCampusEvent

#spring.datasource.url=jdbc:mysql://localhost:3306/Database_Name

# ---------- Server ----------
server.port=8080
# ============================================================
#  Smart Campus Event Management System - Application Config
# ============================================================

# ---------- Server ----------
# ---------- H2 In-Memory Database (Default - No installation needed) ----------

# ── Add MySQL ────────────────────────────────────
spring.datasource.url=jdbc:mysql://localhost:3306/campusdb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.url=jdbc:mysql://localhost:3306/smart_campus
spring.datasource.username=YOUR_USERNAME_HERE
spring.datasource.password=YOUR_PASSWORD_HERE
spring.jpa.hibernate.ddl-auto=update
# ── JPA ──────────────────────────────────────────
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# ---------- JPA / Hibernate ----------

spring.jpa.properties.hibernate.format_sql=true

# ---------- MySQL Configuration (Uncomment to use MySQL) ----------
# spring.datasource.url=jdbc:mysql://localhost:3306/campusdb?useSSL=false&serverTimezone=UTC
# spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
# spring.datasource.username=root
# spring.datasource.password=your_password
# spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
# spring.jpa.hibernate.ddl-auto=update

# ---------- Thymeleaf ----------
spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html
spring.thymeleaf.cache=false
spring.thymeleaf.encoding=UTF-8

# ---------- Pagination ----------
spring.data.web.pageable.default-page-size=6
spring.data.web.pageable.max-page-size=50

# ---------- Logging ----------
logging.level.com.campus=DEBUG
logging.level.org.springframework.security=INFO


# ============================================================
#  EMAIL CONFIGURATION
# ============================================================
#
#  OPTION A — Gmail SMTP (recommended for testing)
#  ─────────────────────────────────────────────────
#  1. Go to your Google Account → Security → 2-Step Verification → App Passwords
#  2. Generate an App Password for "Mail"
#  3. Paste it below (NOT your real Gmail password)
#
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_EMAIL@gmail.com
spring.mail.password=YOUR_APP_PASSWORD_HERE
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=3000
spring.mail.properties.mail.smtp.writetimeout=5000
 
#
#  OPTION B — Outlook / Office 365
#  ─────────────────────────────────
# spring.mail.host=smtp.office365.com
# spring.mail.port=587
# spring.mail.username=your_email@outlook.com
# spring.mail.password=your_password
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
 
#
#  OPTION C — Mock Mode (no real emails — logs to console instead)
#  ────────────────────────────────────────────────────────────────
#  Set this to true if you haven't configured SMTP yet.
#  Emails are printed to the console so you can still test the feature.
#
app.mail.mock-mode=false
 
# ---------- App Settings ----------
app.mail.from-name=CampusEvents Team
app.base-url=http://localhost:8080
